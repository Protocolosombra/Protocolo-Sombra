<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PROTOCOLO SOMBRA | ACCESO</title>
    <style>
        /* Estilos base */
        body, html {
            margin: 0; padding: 0; height: 100%;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #050505;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Fondo estilo co-working desenfocado (simulado con gradientes) */
        .background-blur {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 30% 30%, #1a2a3a 0%, #050505 70%);
            z-index: -1;
        }

        /* Contenedor principal */
        .hero-card {
            background: rgba(10, 10, 10, 0.85);
            border: 1px solid #222;
            padding: 50px;
            text-align: center;
            border-radius: 8px;
            backdrop-filter: blur(10px);
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
            width: 90%;
            max-width: 400px;
        }

        h1 { color: #fff; letter-spacing: 8px; font-size: 28px; margin-bottom: 10px; }
        p { color: #00d4ff; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 40px; }

        input {
            width: 100%; padding: 15px; margin-bottom: 20px;
            background: #000; border: 1px solid #444; color: #00d4ff;
            text-align: center; box-sizing: border-box; font-size: 16px;
        }

        button {
            width: 100%; padding: 15px; border: none;
            background: #fff; color: #000; font-weight: bold;
            cursor: pointer; transition: 0.3s;
        }
        button:hover { background: #00d4ff; color: #000; }
    </style>
</head>
<body>

<div class="background-blur"></div>

<div class="hero-card">
    <h1>PROTOCOLO SOMBRA</h1>
    <p>FASE CERO: ACCESO LIMITADO</p>
    <input type="text" placeholder="INTRODUCIR CÓDIGO DE NODO" id="nodeCode">
    <button onclick="checkAccess()">VERIFICAR ACCESO</button>
</div>

<script>
    function checkAccess() {
        const code = document.getElementById('nodeCode').value;
        if(code !== "") {
            alert("Protocolo iniciado. Redirigiendo a nodo seguro...");
        }
    }
</script>

</body>
</html>
